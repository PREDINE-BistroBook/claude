# Cloudflare static assets: pages and scripts are small, so browsers must revalidate them on every load.
# Without this a phone can keep showing yesterday's page for hours after a deploy. Images can stay cached.
/*.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/*.js
  Cache-Control: no-cache
/*.css
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/img/*
  Cache-Control: public, max-age=86400
# 2026-09-14: browser hardening on every page (the API sets its own)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), payment=(self), geolocation=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains
/admin.html
  X-Robots-Tag: noindex
/admin
  X-Robots-Tag: noindex
/account.html
  X-Robots-Tag: noindex
/account
  X-Robots-Tag: noindex
/export.html
  X-Robots-Tag: noindex
/success.html
  X-Robots-Tag: noindex
