# Cloudflare static assets: pages and scripts are small, so browsers must revalidate them on every load.
# Without this a phone can keep showing yesterday's page for hours after a deploy. Images can stay cached.
/*.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/*.js
  Cache-Control: no-cache
/*.css
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/img/*
  Cache-Control: public, max-age=86400
